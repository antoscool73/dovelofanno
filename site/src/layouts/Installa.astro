---
// Pagine di installazione (pubbliche dal 27/11/2026, prima /beta/ dietro Cloudflare Access): barra fissa con le quattro installazioni, una sola volta qui.
import { version } from '../lib/release';

interface Props {
  title: string;
  /** l'installazione di questa pagina, evidenziata nella barra; nessuna per l'inizio e le novità */
  area?: 'synology' | 'qnap' | 'linux' | 'windows';
  /** false nelle novità: la barra mostra solo logo e versione */
  areas?: boolean;
  /** dove porta il secondo collegamento del piede */
  footBack?: 'home' | 'installa';
}
const { title, area, areas = true, footBack = 'installa' } = Astro.props;
const links = [
  { id: 'synology', label: 'Synology', icon: 'i-nas' },
  { id: 'qnap', label: 'QNAP', icon: 'i-nas4' },
  { id: 'linux', label: 'Linux', icon: 'i-term' },
  { id: 'windows', label: 'Windows', icon: 'i-pc' },
];
---
<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/style.css?v=8">
</head>
<body>
<header class="bar">
  <div class="wrap bar-in">
    <a class="home" href="/" aria-label="DoveLoFanno, torna al sito"><img src="/favicon.svg" alt="" width="36" height="36"><b>Dove<span>Lo</span>Fanno</b></a>
    <a class="tag" href="/installa/" aria-label={`Beta ${version}, pagina iniziale dell'installazione`}>Beta {version}</a>
    {areas && (
      <nav class="areas" aria-label="Dove lo installi">
        {links.map((l) => (
          <a href={`/installa/${l.id}/`} aria-current={l.id === area ? 'page' : undefined}><svg class="ico" aria-hidden="true"><use href={`/installa/icone.svg#${l.icon}`}/></svg>{l.label}</a>
        ))}
      </nav>
    )}
  </div>
</header>

<main class="wrap">
  <slot />
</main>

<footer class="wrap small">
  DoveLoFanno è software libero (GPL-3.0 o successive) e non fornisce canali né contenuti. ·
  {footBack === 'home' ? <a href="/">dovelofanno.it</a> : <a href="/installa/">Installa</a>} ·
  <a href="/manuale/">Manuale</a> ·
  <a href="https://github.com/antoscool73/dovelofanno">Codice su GitHub</a> ·
  <a href="https://github.com/antoscool73/dovelofanno/blob/main/CODE_SIGNING.md">Code signing policy</a> ·
  <a href="https://github.com/antoscool73/dovelofanno/blob/main/TRADEMARKS.md">DoveLoFanno™ e uso del marchio</a> ·
  <Fragment set:html={'<!--email_off--><a href="mailto:info@dovelofanno.it">info@dovelofanno.it</a><!--/email_off-->'} />
</footer>
</body>
</html>
