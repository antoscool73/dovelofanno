---
// Home di dovelofanno.it (CSP rigida: solo file del sito, niente in linea). Lo script JSON-LD non viene eseguito.
import Email from '../components/Email.astro';
const ld = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "DoveLoFanno",
  "url": "https://dovelofanno.it/",
  "description": "Cosa guardare stasera e dove vederlo: guida TV, servizi di streaming e i film di casa in un posto solo, con registrazione della TV su NAS o PC.",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "Windows, Linux, Docker",
  "inLanguage": "it",
  "license": "https://www.gnu.org/licenses/gpl-3.0.html",
  "image": "https://dovelofanno.it/img/anteprima.jpg?v=2",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
};
---
<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DoveLoFanno: cosa guardare stasera tra guida TV, streaming e registrazioni</title>
<meta name="description" content="Cosa guardare stasera e dove vederlo: guida TV, Netflix, Prime Video, Disney+ e i film che hai in casa in un posto solo. Registra la TV su NAS o PC. Gratis e libero.">
<link rel="canonical" href="https://dovelofanno.it/">
<meta name="theme-color" content="#0d1015">
<!-- anteprima dei link (WhatsApp, Telegram, Facebook, X) -->
<meta property="og:type" content="website">
<meta property="og:locale" content="it_IT">
<meta property="og:site_name" content="DoveLoFanno">
<meta property="og:url" content="https://dovelofanno.it/">
<meta property="og:title" content="DoveLoFanno: la risposta a «stasera che si guarda?»">
<meta property="og:description" content="Guida TV, streaming, registrazioni e i film che hai già in casa, in un posto solo. Gratis e senza account.">
<meta property="og:image" content="https://dovelofanno.it/img/anteprima.jpg?v=2">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="DoveLoFanno: La risposta a stasera che si guarda? sopra le schermate dell'app.">
<meta name="twitter:card" content="summary_large_image">
<!-- dati strutturati per i motori di ricerca: non è uno script eseguito, la CSP non lo blocca -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(ld)}></script>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/style.css?v=8">
<script is:inline src="/carosello.js?v=1" defer></script>
<script is:inline src="/intro.js?v=2" defer></script>
</head>
<body class="home-page">
<!-- icone a linea, generiche: <svg class="ico"><use href="#i-..."/></svg> -->
<svg width="0" height="0" class="sprite" aria-hidden="true" focusable="false">
  <symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></symbol>
  <symbol id="i-stack" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="5" rx="1.5"/><rect x="3" y="10.5" width="18" height="5" rx="1.5"/><path d="M6 19.5h12"/></symbol>
  <symbol id="i-rec" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.5"/></symbol>
  <symbol id="i-people" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><circle cx="17" cy="9.5" r="2.3"/><path d="M15.5 14.2A4.5 4.5 0 0 1 21 18.5"/></symbol>
  <symbol id="i-phone" viewBox="0 0 24 24"><rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M10.5 18.5h3"/></symbol>
  <symbol id="i-home" viewBox="0 0 24 24"><path d="M3.5 11 12 4l8.5 7"/><path d="M5.5 9.5v10h13v-10"/><path d="M10 19.5v-5h4v5"/></symbol>
</svg>

<header class="h-top">
  <div class="h-wrap">
    <a class="h-logo" href="/"><img src="/favicon.svg" alt="" width="36" height="36"><b>Dove<span>Lo</span>Fanno</b></a>
    <nav class="h-nav" aria-label="Sito">
      <a href="/manuale/">Manuale</a>
      <a class="h-btn small" href="/beta/">Area beta</a>
    </nav>
  </div>
</header>

<section class="h-hero" aria-labelledby="titolo">
  <div class="h-collage" aria-hidden="true">
    <img src="/img/lista.webp" alt=""><img src="/img/guida.webp" alt=""><img src="/img/opera.webp" alt="">
    <img src="/img/cerca.webp" alt=""><img src="/img/lista.webp" alt=""><img src="/img/guida.webp" alt="">
    <img src="/img/opera.webp" alt=""><img src="/img/cerca.webp" alt=""><img src="/img/lista.webp" alt="">
  </div>
  <div class="h-hero-in">
    <h1 id="titolo">La risposta a<br><em>stasera che si guarda?</em></h1>
    <p class="h-sub">Guida TV, abbonamenti in streaming, registrazioni e i film che hai già in casa. In un posto solo.</p>
    <p class="h-sub2">Gratis, senza account e senza pubblicità. Gira a casa tua.</p>
    <div class="h-cta">
      <a class="h-btn" href="/beta/">Sono tra chi lo prova <span aria-hidden="true">›</span></a>
      <Email to="info@dovelofanno.it" class="h-btn ghost">Voglio provarlo anch'io</Email>
    </div>
  </div>
</section>
<div class="h-arc" aria-hidden="true"></div>

<main class="h-wrap">
  <!-- intro col jingle (23/11/2026, musica d'archi dal 24/11): parte muta da sola, col pulsante si rivede con l'audio -->
  <figure class="h-intro">
    <video id="intro" src="/intro.mp4?v=3" poster="/intro.jpg" muted playsinline preload="metadata" aria-label="Il logo di DoveLoFanno animato, con il jingle"></video>
    <button type="button" id="intro-audio" class="h-intro-btn" aria-label="Guarda l'intro con l'audio"><span aria-hidden="true">🔊</span> Con l'audio</button>
  </figure>
  <aside class="h-banner">
    <img src="/favicon.svg" alt="" width="52" height="52">
    <div><strong>In prova con pochi amici, presto per tutti.</strong>
      <span>È un server che installi una volta su un NAS o su un PC sempre acceso. Poi lo usi dal browser, anche dal divano col telefono.</span></div>
  </aside>

  <h2 class="h-h2">Come si presenta</h2>
  <div class="h-row" role="list">
    <figure class="h-shot" role="listitem">
      <span class="h-num" aria-hidden="true">1</span>
      <img src="/img/lista.webp" alt="La mia lista: il film di stasera in grande, con voto, trama e il pulsante Registra; sotto, i titoli da vedere stasera." width="1440" height="900" loading="lazy">
      <figcaption><strong>La mia lista</strong>Il film di stasera e i tuoi titoli, con dove e quando passano.</figcaption>
    </figure>
    <figure class="h-shot" role="listitem">
      <span class="h-num" aria-hidden="true">2</span>
      <img src="/img/guida.webp" alt="Guida TV a griglia: i canali in colonna e i programmi della serata, con generi e voti." width="1440" height="712" loading="lazy">
      <figcaption><strong>Guida TV</strong>Cinque giorni di programmi, con generi, voti, stagione ed episodio.</figcaption>
    </figure>
    <figure class="h-shot" role="listitem">
      <span class="h-num" aria-hidden="true">3</span>
      <img src="/img/cerca.webp" alt="Ricerca dei film con Clint Eastwood ordinati per voto, ognuno con dove si vede: Prime Video, a pagamento o da farsi avvisare." width="1440" height="900" loading="lazy">
      <figcaption><strong>Cerca</strong>Un attore, un regista, un titolo: e per ognuno dove si vede adesso.</figcaption>
    </figure>
    <figure class="h-shot" role="listitem">
      <span class="h-num" aria-hidden="true">4</span>
      <img src="/img/opera.webp" alt="Scheda di un film: locandina, trama, cast, voto e i pulsanti Registra, Trailer, Aggiungi alla mia lista, Avvisami." width="1440" height="900" loading="lazy">
      <figcaption><strong>Scheda</strong>Tutto su un titolo, e un clic per registrarlo o farti avvisare.</figcaption>
    </figure>
    <figure class="h-shot tall" role="listitem">
      <span class="h-num" aria-hidden="true">5</span>
      <img src="/img/telefono.webp" alt="La mia lista sullo schermo di un telefono." width="780" height="1560" loading="lazy">
      <figcaption><strong>Sul telefono</strong>Stessa app, dal divano.</figcaption>
    </figure>
  </div>
  <p class="h-hint">Scorri di lato per vederle tutte.</p>

  <h2 class="h-h2">Perché usarlo</h2>
  <div class="h-cards">
    <div class="h-card"><h3>Stasera, senza girare canali</h3><p>I film e i programmi della serata scelti secondo i tuoi gusti, con il voto IMDb accanto.</p><svg class="ico h-ico" aria-hidden="true"><use href="#i-moon"/></svg></div>
    <div class="h-card"><h3>TV, streaming e casa insieme</h3><p>Ti dice se un titolo passa in TV, se è su Netflix, Prime o Disney+, o se ce l'hai già sul NAS.</p><svg class="ico h-ico" aria-hidden="true"><use href="#i-stack"/></svg></div>
    <div class="h-card"><h3>Registra, anche tutta la serie</h3><p>Con una tua playlist IPTV registra un programma o tutte le puntate, saltando le repliche.</p><svg class="ico h-ico rec" aria-hidden="true"><use href="#i-rec"/></svg></div>
    <div class="h-card"><h3>Profili per la famiglia</h3><p>Ognuno con le sue liste e i suoi avvisi. I profili dei bambini vedono solo quello che è adatto.</p><svg class="ico h-ico" aria-hidden="true"><use href="#i-people"/></svg></div>
    <div class="h-card"><h3>Dal telefono, dal PC, dal tablet</h3><p>Si apre nel browser di qualunque dispositivo di casa. Niente app da installare.</p><svg class="ico h-ico" aria-hidden="true"><use href="#i-phone"/></svg></div>
    <div class="h-card"><h3>I tuoi dati restano a casa</h3><p>Niente account e niente cloud: il programma non manda nulla a nessuno, nemmeno a noi.</p><svg class="ico h-ico" aria-hidden="true"><use href="#i-home"/></svg></div>
  </div>

  <h2 class="h-h2">Domande frequenti</h2>
  <div class="h-faq">
    <details><summary>Cos'è DoveLoFanno?</summary>
      <p>Un programma che mette insieme guida TV, servizi di streaming e i film che hai in casa, e ti dice cosa guardare e
        dove. Se gli dai una playlist IPTV registra anche i programmi.</p></details>
    <details><summary>Quanto costa?</summary>
      <p>Niente. È software libero (licenza GPL-3.0): niente abbonamento, niente pubblicità.</p></details>
    <details><summary>Dove si installa?</summary>
      <p>Su un computer di casa che resta acceso: un NAS con Docker (Synology, QNAP e simili), un mini-PC o un Raspberry Pi,
        oppure un PC Windows. Poi lo usi dal browser di qualunque dispositivo della stessa rete.</p></details>
    <details><summary>Mi dà i canali TV?</summary>
      <p>No. DoveLoFanno non include né fornisce canali o contenuti. Per registrare serve una playlist M3U che hai il
        diritto di usare; senza, guida, liste e streaming funzionano lo stesso.</p></details>
    <details><summary>Che fine fanno i miei dati?</summary>
      <p>Restano sul tuo computer. Il programma parla solo con la tua playlist, con la guida TV, con TMDB per voti e
        locandine, con Telegram se lo colleghi e, una volta al giorno, con questo sito per sapere se c'è una versione
        nuova (si può spegnere).</p></details>
    <details><summary>Come lo provo?</summary>
      <p>Per ora è in prova con pochi amici. Se vuoi provarlo anche tu, scrivi a
        <Email to="info@dovelofanno.it" />.</p></details>
  </div>

  <div class="h-end">
    <p>Vuoi sapere quando esce per tutti, o provarlo prima?</p>
    <Email to="info@dovelofanno.it" class="h-btn">Scrivimi <span aria-hidden="true">›</span></Email>
  </div>
</main>

<footer class="h-wrap h-foot">
  <p>DoveLoFanno è software libero (GPL-3.0 o successive) e non fornisce canali né contenuti. ·
    <Email to="info@dovelofanno.it" /> · <a href="/manuale/">Manuale</a> · <a href="/beta/">Area beta</a> ·
    <a href="https://github.com/antoscool73/dovelofanno">Codice su GitHub</a> · <a href="https://github.com/antoscool73/dovelofanno/blob/main/TRADEMARKS.md">DoveLoFanno™ e uso del marchio</a></p>
  <p>Le immagini mostrano l'app con la guida TV vera. Locandine, voti e dati dei film vengono da TMDB: questo prodotto
    usa l'API di TMDB ma non è approvato né certificato da TMDB.</p>
</footer>
</body>
</html>
