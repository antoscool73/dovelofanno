{
  "openapi": "3.1.1",
  "info": {
    "title": "DoveLoFanno",
    "description": "API del server domestico DoveLoFanno: sorgenti, canali, registrazioni, backup.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Stato del server",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/streams": {
      "get": {
        "tags": [
          "Canali"
        ],
        "summary": "Tutti i flussi (o quelli di una playlist) con l'esito dell'ultimo controllo",
        "parameters": [
          {
            "name": "sourceId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StreamRow"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sources": {
      "get": {
        "tags": [
          "Sorgenti"
        ],
        "summary": "Playlist M3U dell'utente",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SourceRow"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Sorgenti"
        ],
        "summary": "Aggiunge una playlist (indirizzo http/https o file sul server), la importa e ne controlla i flussi",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewSource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sources/{id}": {
      "patch": {
        "tags": [
          "Sorgenti"
        ],
        "summary": "Modifica nome, limite di connessioni, attivazione o priorità di una playlist",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourcePatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceRow"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "tags": [
          "Sorgenti"
        ],
        "summary": "Toglie una playlist e i suoi flussi (i canali restano)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/sources/{id}/refresh": {
      "post": {
        "tags": [
          "Sorgenti"
        ],
        "summary": "Rilegge la playlist",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResult"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sources/{id}/check": {
      "post": {
        "tags": [
          "Sorgenti"
        ],
        "summary": "Controlla con ffprobe tutti i flussi della playlist, in background",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/channels": {
      "get": {
        "tags": [
          "Canali"
        ],
        "summary": "Canali con il numero di flussi e di flussi funzionanti",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChannelRow"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/channels/{id}/streams": {
      "get": {
        "tags": [
          "Canali"
        ],
        "summary": "Flussi di un canale con l'esito dell'ultimo controllo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StreamRow"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recordings": {
      "get": {
        "tags": [
          "Registrazioni"
        ],
        "summary": "Tutte le registrazioni, le più recenti prima",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecordingRow"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Registrazioni"
        ],
        "summary": "Programma una registrazione (margini e formato predefiniti se mancano); risponde con gli avvisi",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewRecording"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduledRecording"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recordings/{id}": {
      "get": {
        "tags": [
          "Registrazioni"
        ],
        "summary": "Una registrazione con i suoi spezzoni",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "tags": [
          "Registrazioni"
        ],
        "summary": "Annulla una registrazione non ancora partita",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recordings/{id}/stop": {
      "post": {
        "tags": [
          "Registrazioni"
        ],
        "summary": "Ferma una registrazione in corso (si unisce quello che c'è) o annulla una in programma",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profiles": {
      "get": {
        "tags": [
          "Profili"
        ],
        "summary": "Profili della famiglia (gli adulti prima)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProfileRow"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Profili"
        ],
        "summary": "Crea un profilo con la sua lista «La mia serata in TV»; PIN facoltativo (4-8 cifre) solo per gli adulti",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewProfile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileRow"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profiles/{id}": {
      "patch": {
        "tags": [
          "Profili"
        ],
        "summary": "Modifica nome, colore, tipo o PIN di un profilo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfilePatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileRow"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Profili"
        ],
        "summary": "Elimina un profilo con le sue liste, preferenze e avvisi (non l'ultimo adulto)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profiles/{id}/unlock": {
      "post": {
        "tags": [
          "Profili"
        ],
        "summary": "Controlla il PIN di un profilo prima di entrarci",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PinCheck"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/backups": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Copie del database (ogni notte alle 3, si tengono le ultime 7)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BackupInfo"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Sistema"
        ],
        "summary": "Fa subito una copia del database",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackupInfo"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "required": [
          "error"
        ],
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "BackupInfo": {
        "required": [
          "name",
          "bytes",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "format": "int64"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ChannelRow": {
        "required": [
          "id",
          "key",
          "name",
          "logo",
          "group",
          "excluded",
          "streams",
          "streamsOk"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "logo": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "excluded": {
            "type": "boolean"
          },
          "streams": {
            "type": "integer",
            "format": "int32"
          },
          "streamsOk": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Health": {
        "required": [
          "status",
          "api",
          "database",
          "running"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "api": {
            "type": "string"
          },
          "database": {
            "type": "integer",
            "format": "int32"
          },
          "running": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ImportResult": {
        "required": [
          "sourceId",
          "channels",
          "added",
          "removed",
          "drm",
          "epgUrl"
        ],
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "integer",
            "format": "int64"
          },
          "channels": {
            "type": "integer",
            "format": "int32"
          },
          "added": {
            "type": "integer",
            "format": "int32"
          },
          "removed": {
            "type": "integer",
            "format": "int32"
          },
          "drm": {
            "type": "integer",
            "format": "int32"
          },
          "epgUrl": {
            "type": "string"
          }
        }
      },
      "LostRange": {
        "required": [
          "from",
          "to"
        ],
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NewProfile": {
        "required": [
          "name",
          "isChild",
          "avatar",
          "pin"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "isChild": {
            "type": "boolean"
          },
          "avatar": {
            "type": [
              "null",
              "string"
            ]
          },
          "pin": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "NewRecording": {
        "required": [
          "channelId",
          "title",
          "start",
          "stop",
          "beforeMin",
          "afterMin",
          "format"
        ],
        "type": "object",
        "properties": {
          "channelId": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "stop": {
            "type": "string",
            "format": "date-time"
          },
          "beforeMin": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "afterMin": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "format": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "NewSource": {
        "required": [
          "name",
          "url"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "PartRow": {
        "required": [
          "id",
          "partNo",
          "streamId",
          "url",
          "file",
          "startedAt",
          "endedAt",
          "exitReason"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "partNo": {
            "type": "integer",
            "format": "int32"
          },
          "streamId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "url": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "exitReason": {
            "type": "string"
          }
        }
      },
      "PinCheck": {
        "required": [
          "pin"
        ],
        "type": "object",
        "properties": {
          "pin": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProfilePatch": {
        "required": [
          "name",
          "isChild",
          "avatar",
          "pin",
          "clearPin"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "isChild": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "avatar": {
            "type": [
              "null",
              "string"
            ]
          },
          "pin": {
            "type": [
              "null",
              "string"
            ]
          },
          "clearPin": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "ProfileRow": {
        "required": [
          "id",
          "name",
          "isChild",
          "avatar",
          "hasPin",
          "inheritsSubscriptions"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "isChild": {
            "type": "boolean"
          },
          "avatar": {
            "type": "string"
          },
          "hasPin": {
            "type": "boolean"
          },
